# ===================================
# VARIABLES DE ENTORNO - DEPLOY (Render / Docker)
# ===================================
# Copia este archivo a .env y completa los valores
# IMPORTANTE: NUNCA subas .env a GitHub (está en .gitignore)

# Base de datos MariaDB (Filess.io / Render)
DB_URL=jdbc:mariadb://HOST:PUERTO/NOMBRE_BASE_DATOS
DB_USERNAME=usuario_de_la_base
DB_PASSWORD=tu_contraseña_segura_aqui

# JWT Secret: genera una clave aleatoria larga (32+ bytes) con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# NUNCA reutilices secretos que hayan estado en el historial de git.
JWT_SECRET=genera_una_clave_aleatoria_segura_aqui

# Frontend URL (CORS)
FRONTEND_URL=https://tu-frontend.onrender.com

# Puerto (Render inyecta la variable PORT dinámicamente)
PORT=8080

# Cloudinary (opcional si usas subida de imágenes)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
